;;; test-powershell.el --- PowerShell workflow regression tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'powershell)
(defvar lsp-server-install-dir nil)
(defvar lsp-enable-file-watchers t)
(defvar lsp--cur-workspace nil)
(defvar lsp-managed-mode nil)
(defvar lsp--buffer-workspaces nil)
(defvar +lookup-definition-functions nil)
(load (expand-file-name "../config/doom/config-powershell.el"
                        (file-name-directory (or load-file-name buffer-file-name))))

(ert-deftest powershell-workflow-imenu-keeps-tests-and-functions ()
  (with-temp-buffer
    (insert "function Get-Sample {}\n"
            "Describe \"suite\" {\n Context 'nested' {\n"
            "  It \"works\" { $true }\n }}\n"
            "# It 'comment' {}\n"
            "$example = @'\nIt \"example, not a test\" {}\n'@\n")
    (powershell-mode)
    (font-lock-ensure)
    (goto-char (point-min))
    (search-forward "Describe")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-keyword-face))
    (let ((index (my/powershell--imenu-index)))
      (should (equal (mapcar #'car (cdr (assoc "Pester" index)))
                     '("Describe suite" "Context nested" "It works")))
      (should (string-match-p "Get-Sample" (prin1-to-string index))))
    (setq-local imenu-create-index-function (lambda () '(("LSP symbol" . 1))))
    (my/powershell--imenu-setup)
    (should (assoc "Pester" (my/powershell--imenu-index)))
    (should (assoc "LSP symbol" (my/powershell--imenu-index)))
    (my/powershell--imenu-setup)
    (should (assoc "LSP symbol" (my/powershell--imenu-index)))))

(ert-deftest powershell-workflow-incomplete-name-does-not-break-navigation ()
  (with-temp-buffer
    (insert "Describe 'suite' {}\nIt \"still typing")
    (powershell-mode)
    (should (equal (mapcar #'car (my/powershell--pester-index))
                   '("Describe suite")))))

(ert-deftest powershell-workflow-root-keeps-sibling-scripts-together ()
  (let* ((root (make-temp-file "powershell-root-" t))
         (scripts (expand-file-name "Scripts/" root))
         (tests (expand-file-name "tests/" scripts)))
    (unwind-protect
        (progn
          (make-directory tests t)
          (make-directory (expand-file-name ".git" root))
          (let ((default-directory tests))
            (should (equal (my/powershell--root) scripts))))
      (delete-directory root t))))

(ert-deftest powershell-workflow-disables-only-powershell-server-watches ()
  (let ((lsp-enable-file-watchers t))
    (cl-letf (((symbol-function 'lsp--workspace-client) #'identity)
              ((symbol-function 'lsp--client-server-id) #'identity))
      (let ((lsp--cur-workspace 'pwsh-ls))
        (should-not
         (my/powershell--register-capability (lambda () lsp-enable-file-watchers))))
      (let ((lsp--cur-workspace 'clangd))
        (should
         (my/powershell--register-capability (lambda () lsp-enable-file-watchers))))
      (should lsp-enable-file-watchers))))

(ert-deftest powershell-workflow-restarts-retain-only-owned-powershell-roots ()
  (let ((original (lambda (session file) (list session file))))
    (with-temp-buffer
      (powershell-mode)
      (should (equal (my/powershell--retain-root original 'session "/module.ps1")
                     '(session "/module.ps1")))
      (setq-local my/powershell--navigation-root "/project/Scripts/")
      (should (equal (my/powershell--retain-root original 'session "/module.ps1")
                     "/project/Scripts/")))
    (with-temp-buffer
      (setq-local my/powershell--navigation-root "/project/Scripts/")
      (should (equal (my/powershell--retain-root original 'session "/source.cpp")
                     '(session "/source.cpp"))))))

(ert-deftest powershell-workflow-module-source-respects-path-precedence-and-version ()
  (let* ((root (make-temp-file "powershell-modules-" t))
         (first (expand-file-name "first/" root))
         (second (expand-file-name "second/" root)))
    (unwind-protect
        (progn
          (dolist (entry `((,first . "3.4.0") (,first . "3.10.0") (,second . "5.0.0")))
            (let ((directory (expand-file-name
                              (concat "Pester/" (cdr entry)) (car entry))))
              (make-directory directory t)
              (with-temp-file (expand-file-name "Pester.psd1" directory))))
          (should (equal (my/powershell--module-directory "Pester" (list first second))
                         (expand-file-name "Pester/3.10.0" first)))
          (should-not (my/powershell--module-directory "Missing" (list first second)))
          (should-error (my/powershell--module-directory "../escape" (list first))
                        :type 'user-error))
      (delete-directory root t))))

(ert-deftest powershell-workflow-library-roots-are-powershell-only-and-idempotent ()
  (let ((folders (make-hash-table :test #'equal))
        (parameters '(:rootUri "/scripts" :workspaceFolders [(:uri "/scripts")]))
        sent)
    (puthash "/scripts" '(pwsh-ls) folders)
    (puthash "/cpp" '(clangd) folders)
    (cl-letf (((symbol-function 'lsp--workspace-client) #'identity)
              ((symbol-function 'lsp--client-server-id) #'identity)
              ((symbol-function 'lsp-session) #'ignore)
              ((symbol-function 'lsp-session-folder->servers) (lambda (_) folders))
              ((symbol-function 'lsp-f-canonical) #'identity)
              ((symbol-function 'lsp--path-to-uri) #'identity)
              ((symbol-function 'my/powershell--library-directories)
               (lambda () '("/modules/Pester/3.4.0"))))
      (let ((lsp--cur-workspace 'pwsh-ls))
        (my/powershell--initialize-libraries
         (lambda (method params &rest args) (setq sent (list method params args)))
         "initialize" parameters :mode 'detached)
        (should (equal (car sent) "initialize"))
        (should (equal (nth 2 sent) '(:mode detached)))
        (should (= (length (plist-get (cadr sent) :workspaceFolders)) 2))
        (should (= (length (plist-get parameters :workspaceFolders)) 1))
        (my/powershell--initialize-libraries
         (lambda (_method params &rest _) (setq sent params))
         "initialize" (cadr sent))
        (should (= (length (plist-get sent :workspaceFolders)) 2)))
      (should (equal (gethash "/modules/Pester/3.4.0" folders) '(pwsh-ls)))
      (should (equal (gethash "/scripts" folders) '(pwsh-ls)))
      (should (equal (gethash "/cpp" folders) '(clangd)))
      (let ((lsp--cur-workspace 'clangd))
        (my/powershell--initialize-libraries
         (lambda (_method params &rest _) (setq sent params))
         "initialize" parameters)
        (should (eq sent parameters)))
      (let ((lsp--cur-workspace 'pwsh-ls))
        (my/powershell--initialize-libraries
         (lambda (_method params &rest _) (setq sent params))
         "textDocument/definition" parameters)
        (should (eq sent parameters)))
      (should (equal (gethash "/modules/Pester/3.4.0" folders) '(pwsh-ls))))))

(ert-deftest powershell-workflow-definition-does-not-inherit-broad-fallbacks ()
  (let ((+lookup-definition-functions '(expensive-project-search)))
    (with-temp-buffer
      (powershell-mode)
      (should (equal +lookup-definition-functions '(my/powershell--definition)))
      (let ((lsp-managed-mode nil))
        (should-error (my/powershell--definition) :type 'user-error))
      (let ((lsp-managed-mode t) (calls 0))
        (cl-letf (((symbol-function 'lsp-find-definition)
                   (lambda () (cl-incf calls))))
          (should (eq (my/powershell--definition) 'deferred))
          (should (= calls 1)))))
    (should (equal +lookup-definition-functions '(expensive-project-search)))))

(ert-deftest powershell-workflow-definition-reuses-origin-server-for-library ()
  (let* ((root (make-temp-file "powershell-library-jump-" t))
         (source (generate-new-buffer " *PowerShell source*"))
         (library (generate-new-buffer " *PowerShell library*"))
         connected)
    (unwind-protect
        (save-window-excursion
          (with-current-buffer library
            (powershell-mode)
            (setq buffer-file-name (expand-file-name "Mock.ps1" root)))
          (switch-to-buffer source)
          (powershell-mode)
          (setq-local lsp-managed-mode t)
          (setq-local lsp--buffer-workspaces '(origin-pwsh))
          (cl-letf (((symbol-function 'lsp-find-definition)
                     (lambda () (switch-to-buffer library)))
                    ((symbol-function 'lsp--open-in-workspace)
                     (lambda (workspace)
                       (should (eq (current-buffer) library))
                       (should (equal lsp--buffer-workspaces '(origin-pwsh)))
                       (setq connected workspace)))
                    ((symbol-function 'lsp-mode)
                     (lambda (argument)
                       (should (= argument 1))
                       (should (equal lsp--buffer-workspaces '(origin-pwsh)))))
                    ((symbol-function 'lsp--workspace-root)
                     (lambda (_) (expand-file-name "Scripts/" root)))
                    ((symbol-function 'my/powershell--library-directories)
                     (lambda () (list root))))
            (my/powershell--definition)
            (should (eq connected 'origin-pwsh))
            (with-current-buffer library
              (should buffer-read-only)
              (should (equal my/powershell--navigation-root
                             (expand-file-name "Scripts/" root))))))
      (kill-buffer source)
      (kill-buffer library)
      (delete-directory root t))))

(ert-deftest powershell-workflow-project-helper-outside-scripts-stays-editable ()
  (let* ((root (make-temp-file "powershell-project-jump-" t))
         (source (generate-new-buffer " *PowerShell source*"))
         (helper (generate-new-buffer " *PowerShell helper*"))
         (scripts (expand-file-name "Scripts/" root))
         (tools (expand-file-name "tools/" root)))
    (unwind-protect
        (save-window-excursion
          (make-directory scripts)
          (make-directory tools)
          (with-current-buffer helper
            (powershell-mode)
            (setq buffer-file-name (expand-file-name "ProjectHelpers.ps1" tools)))
          (switch-to-buffer source)
          (powershell-mode)
          (setq-local lsp-managed-mode t)
          (setq-local lsp--buffer-workspaces '(origin-pwsh))
          (cl-letf (((symbol-function 'lsp-find-definition)
                     (lambda () (switch-to-buffer helper)))
                    ((symbol-function 'lsp--workspace-root) (lambda (_) scripts))
                    ((symbol-function 'my/powershell--library-directories)
                     (lambda () (list (expand-file-name "modules/" root))))
                    ((symbol-function 'lsp-mode) #'ignore)
                    ((symbol-function 'lsp--open-in-workspace) #'ignore))
            (my/powershell--definition)
            (should-not buffer-read-only)
            (should (equal lsp--buffer-workspaces '(origin-pwsh)))
            (should (equal my/powershell--navigation-root scripts))))
      (kill-buffer source)
      (kill-buffer helper)
      (delete-directory root t))))

(ert-deftest powershell-workflow-never-runs-an-unsaved-test-file ()
  (let* ((file (make-temp-file "powershell-unsaved-" nil ".Tests.ps1"))
         (buffer (find-file-noselect file)))
    (unwind-protect
        (with-current-buffer buffer
          (insert "Describe 'unsaved' {}")
          (cl-letf (((symbol-function 'compilation-start)
                     (lambda (&rest _) (ert-fail "Unsaved tests were executed"))))
            (should-error (my/powershell-test-file file) :type 'user-error)))
      (with-current-buffer buffer (set-buffer-modified-p nil))
      (kill-buffer buffer)
      (delete-file file))))

(ert-deftest powershell-workflow-rerun-rechecks-source-without-saving-other-buffers ()
  (let* ((file (make-temp-file "powershell-rerun-" nil ".Tests.ps1"))
         (source (find-file-noselect file))
         (output (generate-new-buffer " *Pester rerun test*"))
         (my/powershell--test-buffers (make-hash-table :test #'equal)))
    (unwind-protect
        (with-current-buffer source
          (with-current-buffer output
            (setq-local my/powershell--test-file file))
          (puthash (my/powershell--root) output my/powershell--test-buffers)
          (insert "Describe 'not saved' {}")
          (cl-letf (((symbol-function 'save-some-buffers)
                     (lambda (&rest _) (ert-fail "Rerun tried saving other buffers")))
                    ((symbol-function 'my/powershell--test-command) #'identity)
                    ((symbol-function 'compilation-start)
                     (lambda (command &rest _)
                       (should (equal command file))
                       output)))
            (should-error (my/powershell-test-rerun) :type 'user-error)
            (set-buffer-modified-p nil)
            (should (eq (my/powershell-test-rerun) output))))
      (with-current-buffer source (set-buffer-modified-p nil))
      (kill-buffer source)
      (kill-buffer output)
      (delete-file file))))

(ert-deftest powershell-workflow-reuses-newest-installed-editor-services ()
  (let* ((root (make-temp-file "powershell-services-" t))
         (older (expand-file-name "ms-vscode.powershell-2025.9.0/modules" root))
         (newer (expand-file-name "ms-vscode.powershell-2025.10.0/modules" root))
         (lsp-server-install-dir (expand-file-name "lsp/" root))
         (my/powershell-editor-services-directory nil))
    (unwind-protect
        (progn
          (dolist (directory (list older newer))
            (make-directory (expand-file-name "PowerShellEditorServices" directory) t)
            (with-temp-file
                (expand-file-name "PowerShellEditorServices/Start-EditorServices.ps1"
                                  directory)))
          (cl-letf (((symbol-function 'file-expand-wildcards)
                     (lambda (&rest _) (list older newer))))
            (should (equal (my/powershell--server-directory) newer))
            (let ((my/powershell-editor-services-directory
                   (expand-file-name "missing/" root)))
              (should-error (my/powershell--server-directory) :type 'user-error))))
      (delete-directory root t))))

(ert-run-tests-batch-and-exit)
