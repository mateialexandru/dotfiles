;;; test-windows-performance.el --- Shared Windows regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)

(defvar features nil)
(defvar doom-switch-buffer-hook nil)
(defvar super-save-when-buffer-switched nil)
(defvar super-save-auto-save-when-idle nil)
(defvar super-save-when-focus-lost nil)
(defvar magit-status-headers-hook nil)
(defvar magit-status-sections-hook nil)
(defvar org-babel-sh-command nil)

(defmacro after! (feature &rest body)
  (declare (indent 1))
  `(with-eval-after-load ',feature ,@body))

(defmacro map! (&rest _)
  nil)

(defconst dotfiles-windows-test-module
  (expand-file-name "../config/doom/config-windows.el"
                    (file-name-directory (or load-file-name buffer-file-name))))

(defconst windows-test-git-root
  (expand-file-name "dotfiles Git with spaces/" temporary-file-directory))

(defun windows-test-load ()
  (let ((exec-path (copy-sequence exec-path))
        (process-environment (copy-sequence process-environment)))
    (cl-letf (((symbol-function 'executable-find)
               (lambda (name)
                 (when (equal name "git")
                   (expand-file-name "cmd/git.exe" windows-test-git-root))))
              ((symbol-function 'locate-dominating-file)
               (lambda (file marker)
                 (when (and (equal file (expand-file-name "cmd/git.exe" windows-test-git-root))
                            (equal marker "bin/bash.exe"))
                   windows-test-git-root)))
              ((symbol-function 'file-executable-p)
               (lambda (file)
                 (member file
                         (mapcar (lambda (name) (expand-file-name name windows-test-git-root))
                                 '("bin/bash.exe" "mingw64/bin/git.exe")))))
              ((symbol-function 'w32-short-file-name) (lambda (_) nil)))
      (load dotfiles-windows-test-module nil t))))

(windows-test-load)

(ert-deftest windows-font-backends-update-only-changed-gui-frames ()
  (let* ((default-frame-alist '((width . 100) (font-backend gdi harfbuzz)))
         (backends '((gui-old gdi harfbuzz) (gui-ready harfbuzz gdi)))
         (original-framep (symbol-function 'framep))
         (window (selected-window))
         (reloads 0)
         updates)
    (cl-letf (((symbol-function 'frame-list)
               (lambda () '(gui-old gui-ready terminal)))
              ((symbol-function 'framep)
               (lambda (frame)
                 (if (memq frame '(gui-old gui-ready)) 'w32
                   (funcall original-framep frame))))
              ((symbol-function 'frame-selected-window) (lambda (_) window))
              ((symbol-function 'frame-parameter)
               (lambda (frame parameter)
                 (should (eq parameter 'font-backend))
                 (alist-get frame backends)))
              ((symbol-function 'set-frame-parameter)
               (lambda (frame parameter value)
                 (should (eq parameter 'font-backend))
                 (push frame updates)
                 (setf (alist-get frame backends) value)))
              ((symbol-function 'doom/reload-font)
               (lambda () (cl-incf reloads))))
      (my/windows-apply-font-backends)
      (my/windows-apply-font-backends)
      (should (equal updates '(gui-old)))
      (should (= reloads 1))
      (should (= (alist-get 'width default-frame-alist) 100))
      (should (equal (alist-get 'font-backend default-frame-alist)
                     '(harfbuzz gdi))))))

(ert-deftest windows-font-backends-can-opt-into-gdi ()
  (let ((default-frame-alist '((font-backend harfbuzz gdi)))
        (my/windows-font-backends '(gdi harfbuzz)))
    (cl-letf (((symbol-function 'frame-list) (lambda () nil)))
      (my/windows-apply-font-backends)
      (should (equal (alist-get 'font-backend default-frame-alist)
                     '(gdi harfbuzz))))))

(ert-deftest windows-vc-defers-only-local-git ()
  (with-temp-buffer
    (setq buffer-file-name "c:/windows-probe.org")
    (let ((vc-handled-backends '(Git)))
      (cl-letf (((symbol-function 'file-symlink-p) (lambda (_) nil)))
        (should (my/windows-vc-defer-p)))
      (cl-letf (((symbol-function 'file-symlink-p) (lambda (_) "target")))
        (should-not (my/windows-vc-defer-p)))
      (setq buffer-file-name "/ssh:example:/probe.org")
      (should-not (my/windows-vc-defer-p)))
    (setq buffer-file-name "c:/windows-probe.org")
    (let ((vc-handled-backends '(Git SVN)))
      (should-not (my/windows-vc-defer-p)))))

(ert-deftest windows-vc-queues-once-without-refreshing ()
  (with-temp-buffer
    (setq buffer-file-name "c:/windows-probe.org")
    (let ((vc-handled-backends '(Git))
          (timer (timer-create))
          (scheduled 0)
          (refreshed 0))
      (cl-letf (((symbol-function 'file-symlink-p) (lambda (_) nil))
                ((symbol-function 'vc-refresh-state)
                 (lambda () (cl-incf refreshed)))
                ((symbol-function 'run-with-idle-timer)
                 (lambda (delay repeat callback buffer file)
                   (should (= delay 0.5))
                   (should-not repeat)
                   (should (eq callback #'my/windows-vc-refresh-on-idle))
                   (should (eq buffer (current-buffer)))
                   (should (equal file buffer-file-name))
                   (cl-incf scheduled)
                   timer)))
        (my/windows-vc-find-file-h)
        (my/windows-vc-refresh-soon-h)
        (should (= scheduled 1))
        (should (= refreshed 0))
        (should (memq #'my/windows-vc-cancel-refresh-h kill-buffer-hook))
        (my/windows-vc-cancel-refresh-h)
        (should-not my/windows-vc-refresh-timer)))))

(ert-deftest windows-vc-refreshes-visible-buffer-once ()
  (with-temp-buffer
    (setq buffer-file-name "c:/windows-probe.org")
    (let ((vc-handled-backends '(Git))
          (refreshed 0))
      (cl-letf (((symbol-function 'file-symlink-p) (lambda (_) nil))
                ((symbol-function 'get-buffer-window) (lambda (&rest _) t))
                ((symbol-function 'vc-refresh-state)
                 (lambda () (cl-incf refreshed))))
        (setq my/windows-vc-refresh-timer (timer-create))
        (my/windows-vc-refresh-on-idle (current-buffer) buffer-file-name)
        (should-not my/windows-vc-refresh-timer)
        (should my/windows-vc-refreshed)
        (my/windows-vc-refresh-on-idle (current-buffer) buffer-file-name)
        (should (= refreshed 1))))))

(ert-deftest windows-vc-hidden-buffer-can-be-requeued ()
  (with-temp-buffer
    (setq buffer-file-name "c:/windows-probe.org")
    (let ((vc-handled-backends '(Git))
          (timer (timer-create)))
      (cl-letf (((symbol-function 'file-symlink-p) (lambda (_) nil))
                ((symbol-function 'get-buffer-window) (lambda (&rest _) nil))
                ((symbol-function 'vc-refresh-state)
                 (lambda () (ert-fail "Hidden buffer was refreshed")))
                ((symbol-function 'run-with-idle-timer) (lambda (&rest _) timer)))
        (my/windows-vc-refresh-on-idle (current-buffer) buffer-file-name)
        (should-not my/windows-vc-refreshed)
        (my/windows-vc-refresh-soon-h)
        (should (eq my/windows-vc-refresh-timer timer))
        (my/windows-vc-cancel-refresh-h)))))

(ert-deftest windows-vc-ignores-stale-and-dead-buffers ()
  (let ((buffer (generate-new-buffer " *windows-vc-test*")))
    (unwind-protect
        (with-current-buffer buffer
          (setq buffer-file-name "c:/renamed-probe.org")
          (cl-letf (((symbol-function 'vc-refresh-state)
                     (lambda () (ert-fail "Stale file was refreshed"))))
            (my/windows-vc-refresh-on-idle buffer "c:/original-probe.org")
            (should-not my/windows-vc-refreshed)))
      (kill-buffer buffer))
    (my/windows-vc-refresh-on-idle buffer "c:/original-probe.org")))

(ert-deftest windows-vc-refresh-errors-remain-visible-and-retryable ()
  (with-temp-buffer
    (setq buffer-file-name "c:/windows-probe.org")
    (let ((vc-handled-backends '(Git)))
      (cl-letf (((symbol-function 'file-symlink-p) (lambda (_) nil))
                ((symbol-function 'get-buffer-window) (lambda (&rest _) t))
                ((symbol-function 'vc-refresh-state)
                 (lambda () (error "Probe refresh failure"))))
        (should-error (my/windows-vc-refresh-on-idle (current-buffer) buffer-file-name)
                      :type 'error)
        (should-not my/windows-vc-refreshed)
        (should-not my/windows-vc-refresh-timer)))))

(ert-deftest windows-vc-preserves-nondeferred-visit-behavior ()
  (with-temp-buffer
    (setq buffer-file-name "c:/windows-probe.org")
    (let ((vc-handled-backends '(Git SVN))
          (refreshed 0))
      (cl-letf (((symbol-function 'vc-refresh-state)
                 (lambda () (cl-incf refreshed)))
                ((symbol-function 'run-with-idle-timer)
                 (lambda (&rest _) (ert-fail "Non-Git visit was deferred"))))
        (my/windows-vc-find-file-h)
        (should (= refreshed 1))))))

(ert-deftest windows-vc-replaces-only-initial-refresh-hook ()
  (should (memq #'my/windows-vc-find-file-h find-file-hook))
  (should-not (memq #'vc-refresh-state find-file-hook))
  (should (memq #'my/windows-vc-refresh-soon-h doom-switch-buffer-hook))
  (should-not (memq #'my/windows-vc-find-file-h after-save-hook))
  (should-not (memq #'my/windows-vc-find-file-h after-revert-hook)))

(ert-deftest windows-auto-save-retains-idle-and-focus-loss ()
  (let ((super-save-when-buffer-switched t)
        (super-save-auto-save-when-idle t)
        (super-save-when-focus-lost t)
        (features (cons 'super-save features))
        (window-buffer-change-functions '(super-save-window-change-handler ignore))
        (window-selection-change-functions '(super-save-window-change-handler ignore)))
    (windows-test-load)
    (should-not super-save-when-buffer-switched)
    (should super-save-auto-save-when-idle)
    (should super-save-when-focus-lost)
    (should (equal window-buffer-change-functions '(ignore)))
    (should (equal window-selection-change-functions '(ignore)))))

(ert-deftest windows-vc-preserves-hook-order-on-reload ()
  (let ((find-file-hook '(ignore vc-refresh-state epa-file-find-file-hook))
        (doom-switch-buffer-hook nil))
    (windows-test-load)
    (windows-test-load)
    (should (equal find-file-hook
                   '(ignore my/windows-vc-find-file-h epa-file-find-file-hook)))
    (should (equal doom-switch-buffer-hook '(my/windows-vc-refresh-soon-h)))))

(ert-deftest windows-magit-removes-tags-from-headers-not-sections ()
  (let ((features (cons 'magit features))
        (magit-status-headers-hook '(magit-insert-tags-header ignore))
        (magit-status-sections-hook '(magit-insert-status-headers ignore)))
    (windows-test-load)
    (should (equal magit-status-headers-hook '(ignore)))
    (should (equal magit-status-sections-hook '(magit-insert-status-headers ignore)))))

(ert-deftest windows-git-bash-discovery-supports-nonstandard-unshortened-paths ()
  (let ((features (cons 'org features))
        (org-babel-sh-command nil))
    (windows-test-load)
    (let ((bash (expand-file-name "bin/bash.exe" windows-test-git-root)))
      (should (equal shell-file-name bash))
      (should (equal explicit-shell-file-name bash))
      (should (equal org-babel-sh-command (shell-quote-argument bash))))))

(ert-deftest windows-real-executable-rejects-store-alias-directories ()
  (let ((exec-path '("C:/tools" "C:/Users/test/WindowsApps" "C:/Git/bin")))
    (cl-letf (((symbol-function 'executable-find)
               (lambda (_)
                 (should (equal exec-path '("C:/tools" "C:/Git/bin")))
                 "C:/tools/python.exe")))
      (should (equal (my/windows-real-executable "python") "C:/tools/python.exe")))))

(ert-run-tests-batch-and-exit)
